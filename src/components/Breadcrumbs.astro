---
interface Props {
  items: Array<{ label: string; href?: string }>;
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Ruta de navegación" aria-labelledby="breadcrumbs-label">
  <span id="breadcrumbs-label" class="visually-hidden">Ruta de navegación</span>
  <ol class="breadcrumbs-list">
    {items.map((item, index) => (
      <li class="breadcrumbs-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        {item.href ? (
          <a href={item.href} itemprop="item" class="breadcrumbs-link">
            <span itemprop="name">{item.label}</span>
          </a>
        ) : (
          <span itemprop="name" class="breadcrumbs-current" aria-current="page">{item.label}</span>
        )}
        <meta itemprop="position" content={String(index + 1)} />
        {index < items.length - 1 && <span class="breadcrumbs-separator" aria-hidden="true">·</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: 0.9rem 0 0.75rem;
    font-size: 0.82rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  /* When inside .container already, override */
  :global(.breadcrumbs .breadcrumbs-list) {
    max-width: none;
    padding-inline: 0;
    margin-inline: 0;
  }

  .breadcrumbs-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
  }

  .breadcrumbs-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    font-weight: 500;
  }

  .breadcrumbs-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumbs-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .breadcrumbs-current {
    color: var(--color-text);
    font-weight: 600;
  }

  .breadcrumbs-separator {
    color: var(--color-text-light);
    font-size: 0.9em;
    opacity: 0.7;
  }
</style>
