---
import { siteConfig } from '@config/site';
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${siteConfig.name} - Inicio`}>
      <span class="logo-mark" aria-hidden="true">EP</span>
      <span class="logo-text">
        <span>Entorno</span>
        <span>Publicitario</span>
      </span>
    </a>

    <nav class="main-nav" id="main-navigation" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/">Inicio</a></li>
        <li><a href="/servicios">Servicios</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
      <div class="nav-mobile-cta">
        <a href="/contacto" class="btn btn-primary nav-cta-mobile">Solicitar presupuesto</a>
        <a href={`tel:${siteConfig.telephone.replace(/\s+/g, '')}`} class="nav-phone">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {siteConfig.telephone}
        </a>
      </div>
    </nav>

    <div class="header-actions">
      <a href="/contacto" class="header-cta" aria-label="Solicitar presupuesto">
        <span>Solicitar presupuesto</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>

      <button class="nav-toggle" aria-expanded="false" aria-controls="main-navigation" aria-label="Abrir menú">
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    background: var(--color-primary);
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: -0.05em;
    line-height: 1;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 0.95;
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .logo-text span:first-child {
    font-weight: 800;
  }

  .logo-text span:last-child {
    font-weight: 500;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  /* Desktop nav */
  .main-nav {
    display: block;
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: block;
    padding: 0.45rem 0.75rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    letter-spacing: -0.01em;
  }

  .nav-list a:hover {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .nav-list a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 600;
  }

  .nav-mobile-cta {
    display: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--color-primary);
    color: #fff;
    padding: 0.62rem 1.05rem;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    border: 1px solid var(--color-primary);
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    white-space: nowrap;
  }

  .header-cta:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .header-cta svg {
    flex-shrink: 0;
    opacity: 0.9;
  }

  /* Hamburger — progressive enhancement */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-toggle:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-muted);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .hamburger {
    position: relative;
    width: 18px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: background var(--transition-fast);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform var(--transition-fast), top var(--transition-fast), bottom var(--transition-fast);
  }

  .hamburger::before { top: -6px; }
  .hamburger::after { bottom: -6px; }

  .nav-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .nav-toggle[aria-expanded="true"] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .hamburger::after {
    bottom: 0;
    transform: rotate(-45deg);
  }

  /* PE: no-js shows nav, js collapses */
  .js .nav-toggle {
    display: flex;
  }

  .js .main-nav {
    display: none;
  }

  .js .main-nav.open {
    display: block;
  }

  @media (min-width: 900px) {
    .main-nav,
    .js .main-nav,
    .js .main-nav.open {
      display: block;
      position: static;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0;
    }

    .header-inner {
      gap: var(--space-xl);
    }

    .nav-toggle,
    .js .nav-toggle {
      display: none !important;
    }
  }

  @media (max-width: 899px) {
    .site-header {
      background: var(--color-surface);
      backdrop-filter: none;
    }

    .main-nav {
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      border-top: 1px solid var(--color-border);
      padding: var(--space-md) var(--container-padding) var(--space-lg);
      box-shadow: var(--shadow-lg);
      display: block;
    }

    .js .main-nav {
      display: none;
    }

    .js .main-nav.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
      margin-bottom: var(--space-md);
    }

    .nav-list a {
      padding: 0.85rem 1rem;
      font-size: 0.95rem;
      border-radius: var(--radius-md);
      background: transparent;
    }

    .nav-list a:hover {
      background: var(--color-primary-light);
    }

    .nav-mobile-cta {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      padding-top: var(--space-md);
      border-top: 1px solid var(--color-border);
    }

    .nav-cta-mobile {
      width: 100%;
      justify-content: center;
      padding: 0.9rem 1rem;
      font-size: 0.9rem;
      border-radius: var(--radius-pill);
    }

    .nav-phone {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      padding: 0.75rem;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-text);
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      background: var(--color-surface);
    }

    .nav-phone:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      background: var(--color-primary-soft);
    }

    .header-cta {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .logo-text {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('.main-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      const next = !expanded;
      toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? 'Cerrar menú' : 'Abrir menú');
      nav.classList.toggle('open', next);
      document.body.style.overflow = next ? 'hidden' : '';
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú');
        nav.classList.remove('open');
        document.body.style.overflow = '';
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú');
        nav.classList.remove('open');
        document.body.style.overflow = '';
        (toggle as HTMLElement).focus();
      }
    });
  }
</script>
