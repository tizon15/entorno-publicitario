---
import { siteConfig } from '@config/site';
---

<header class="site-header" role="banner">
  <div class="header-rule" aria-hidden="true"></div>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${siteConfig.name} - Inicio`}>
      <span class="logo-mark" aria-hidden="true">EP</span>
      <span class="logo-type">
        <span class="logo-name">Entorno Publicitario</span>
        <span class="logo-sub">Imprenta · Madrid — Est. 2004</span>
      </span>
    </a>

    <nav class="main-nav" id="main-navigation" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/">Inicio</a></li>
        <li><a href="/servicios">Servicios</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
      <div class="nav-mobile-cta">
        <a href="/contacto" class="btn btn-primary nav-cta-mobile">Solicitar presupuesto</a>
        <a href={`tel:${siteConfig.telephone.replace(/\s+/g, '')}`} class="nav-phone">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {siteConfig.telephone}
        </a>
      </div>
    </nav>

    <div class="header-actions">
      <span class="header-specs" aria-hidden="true">Prueba digital · FSC · 350g</span>
      <a href="/contacto" class="header-cta" aria-label="Solicitar presupuesto">
        <span>Solicitar presupuesto</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="main-navigation" aria-label="Abrir menú">
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header-rule {
    height: 3px;
    background: var(--color-text);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 68px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: var(--color-text);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 0.88rem;
    letter-spacing: -0.04em;
    line-height: 1;
    border-radius: 2px;
    flex-shrink: 0;
    border: 1px solid var(--color-text);
  }

  .logo-type {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 750;
    letter-spacing: -0.035em;
    color: var(--color-text);
    line-height: 0.95;
  }

  .logo-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .main-nav {
    display: block;
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: block;
    padding: 0.45rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
    border-bottom: 1.5px solid transparent;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-list a:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .nav-mobile-cta {
    display: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-shrink: 0;
  }

  .header-specs {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.5rem;
    border-radius: 3px;
    background: var(--color-background);
  }

  @media (min-width: 1100px) {
    .header-specs {
      display: inline-flex;
    }
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-text);
    color: #fff;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-btn);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    border: 1px solid var(--color-text);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }

  .header-cta:hover {
    background: #fff;
    color: var(--color-text);
  }

  .header-cta svg {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-toggle:focus-visible {
    outline: 1.5px solid var(--color-focus);
    outline-offset: 2px;
  }

  .hamburger {
    position: relative;
    width: 16px;
    height: 1.5px;
    background: var(--color-text);
    transition: background var(--transition-fast);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-text);
    transition: transform var(--transition-fast);
  }

  .hamburger::before { top: -5px; }
  .hamburger::after { bottom: -5px; }

  .nav-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .nav-toggle[aria-expanded="true"] .hamburger::before {
    transform: translateY(5px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .hamburger::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  .js .nav-toggle {
    display: flex;
  }

  .js .main-nav {
    display: none;
  }

  .js .main-nav.open {
    display: block;
  }

  @media (min-width: 900px) {
    .main-nav,
    .js .main-nav,
    .js .main-nav.open {
      display: block;
      position: static;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0;
    }

    .nav-toggle,
    .js .nav-toggle {
      display: none !important;
    }
  }

  @media (max-width: 899px) {
    .main-nav {
      position: absolute;
      top: 71px;
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      border-top: 1px solid var(--color-border);
      padding: var(--space-md) var(--container-padding) var(--space-lg);
      box-shadow: var(--shadow-lg);
      display: block;
    }

    .js .main-nav {
      display: none;
    }

    .js .main-nav.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.1rem;
      margin-bottom: var(--space-md);
    }

    .nav-list a {
      padding: 0.85rem 0.2rem;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--color-border);
    }

    .nav-mobile-cta {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      padding-top: var(--space-md);
    }

    .nav-cta-mobile {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1rem;
      font-size: 0.88rem;
      border-radius: var(--radius-btn);
    }

    .nav-phone {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      padding: 0.7rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text);
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-btn);
      background: var(--color-background);
      font-family: var(--font-mono);
      letter-spacing: 0.02em;
    }

    .header-specs,
    .header-cta {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('.main-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      const next = !expanded;
      toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? 'Cerrar menú' : 'Abrir menú');
      nav.classList.toggle('open', next);
      document.body.style.overflow = next ? 'hidden' : '';
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú');
        nav.classList.remove('open');
        document.body.style.overflow = '';
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú');
        nav.classList.remove('open');
        document.body.style.overflow = '';
        (toggle as HTMLElement).focus();
      }
    });
  }
</script>
