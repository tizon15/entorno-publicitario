---
import { siteConfig } from '@config/site';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-rule" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-mark" aria-hidden="true">EP</div>
        <h2 class="footer-logo">{siteConfig.name}</h2>
        <p class="footer-description">
          Imprenta en Madrid con más de 20 años. Papel, tinta y oficio al servicio de tu marca — taller propio, trato directo.
        </p>
        <address class="footer-address">
          <p class="footer-contact-line">
            <a href={`tel:${siteConfig.telephone.replace(/\s+/g, '')}`}>{siteConfig.telephone}</a>
            <span aria-hidden="true">·</span>
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </p>
        </address>
      </div>

      <nav class="footer-nav" aria-label="Enlaces principales">
        <h3>Navegación</h3>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Servicios principales">
        <h3>Servicios</h3>
        <ul>
          <li><a href="/servicios/tarjetas-visita">Tarjetas de visita</a></li>
        </ul>
      </nav>

      <div class="footer-hours">
        <h3>Horario</h3>
        <p class="footer-hours-main">{siteConfig.openingHours}</p>
        <p class="footer-note">Sábados y domingos: cerrado</p>
        <a href="/contacto" class="footer-cta">Solicitar presupuesto →</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {currentYear} {siteConfig.name}. Todos los derechos reservados.</p>
      <nav aria-label="Enlaces legales">
        <ul class="legal-links">
          <li><a href="/politica-privacidad">Política de privacidad</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: var(--color-background);
    padding: 0 0 1.5rem;
    border-top: none;
    position: relative;
    overflow: hidden;
  }
  .footer-rule {
    height: 4px;
    background: linear-gradient(90deg, var(--color-accent) 0% 28%, #00A9E0 28% 50%, #FFED00 50% 72%, var(--color-background) 72% 100%);
    opacity: 0.95;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin: 2.2rem 0 var(--space-2xl);
  }
  @media (min-width: 640px) { .footer-grid { grid-template-columns: 1.6fr 1fr; gap: var(--space-xl) var(--space-2xl); } }
  @media (min-width: 1024px) { .footer-grid { grid-template-columns: 1.7fr 0.9fr 0.9fr 1fr; gap: var(--space-2xl); } }

  .footer-mark {
    width: 38px; height: 38px; display: grid; place-items: center;
    background: var(--color-accent); border: 1.5px solid var(--color-accent);
    color: #fff; font-family: var(--font-sans); font-weight: 800; font-size: 0.82rem;
    letter-spacing: -0.04em; border-radius: 10px; margin-bottom: var(--space-sm);
    position: relative;
  }
  .footer-logo {
    font-family: var(--font-sans); font-size: 1.1rem; font-weight: 800;
    letter-spacing: -0.03em; margin: 0 0 var(--space-sm); color: #fff; line-height: 1.2;
  }
  .footer-description { color: rgba(255,249,249,0.65); font-size: 0.88rem; line-height: 1.6; margin: 0 0 var(--space-md); max-width: 36ch; font-family: var(--font-sans); }
  .footer-address { font-style: normal; color: rgba(255,249,249,0.65); font-size: 0.88rem; line-height: 1.7; }
  .footer-address p { margin: 0; color: rgba(255,249,249,0.65); }
  .footer-contact-line { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-top: 0.6rem !important; }
  .footer-address a {
    color: var(--color-background); text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.18);
    padding-bottom: 1px; transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .footer-address a:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }

  .footer-nav h3, .footer-hours h3 {
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400;
    letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 var(--space-md); color: var(--color-accent);
  }
  .footer-nav ul { list-style: none; padding: 0; margin: 0; }
  .footer-nav li { margin-bottom: 0.55rem; }
  .footer-nav a { color: rgba(255,249,249,0.65); font-size: 0.88rem; text-decoration: none; transition: color var(--transition-fast); font-family: var(--font-sans); }
  .footer-nav a:hover { color: #fff; }
  .footer-nav a:focus-visible, .legal-links a:focus-visible, .footer-address a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; border-radius: 2px; }

  .footer-hours-main { color: var(--color-background); font-weight: 700; font-size: 0.9rem; margin: 0 0 0.25rem; font-family: var(--font-sans); }
  .footer-note { font-size: 0.82rem; color: rgba(255,249,249,0.45); margin: 0 0 var(--space-md); font-family: var(--font-mono); }
  .footer-cta {
    display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 700;
    color: var(--color-primary); text-decoration: none; background: var(--color-accent-yellow);
    padding: 0.5rem 0.85rem; border-radius: 999px; border: 1px solid var(--color-accent-yellow);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    font-family: var(--font-sans);
  }
  .footer-cta:hover { background: #fff; border-color: #fff; color: var(--color-primary); }

  .footer-bottom {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm);
    padding-top: var(--space-lg); border-top: 1px solid rgba(255,255,255,0.08);
  }
  @media (min-width: 768px) { .footer-bottom { flex-direction: row; justify-content: space-between; align-items: center; } }
  .footer-copy { margin: 0; color: rgba(255,249,249,0.4); font-size: 0.80rem; font-family: var(--font-mono); }
  .legal-links { display: flex; gap: var(--space-lg); list-style: none; margin: 0; padding: 0; }
  .legal-links a { color: rgba(255,249,249,0.4); font-size: 0.80rem; text-decoration: none; transition: color var(--transition-fast); font-family: var(--font-mono); }
  .legal-links a:hover { color: var(--color-background); }
</style>
