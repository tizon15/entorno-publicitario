---
import { siteConfig } from '@config/site';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-mark" aria-hidden="true">EP</div>
        <h2 class="footer-logo">{siteConfig.name}</h2>
        <p class="footer-description">
          Imprenta en Madrid con más de 20 años de experiencia. Papel, tinta y oficio al servicio de tu marca.
        </p>
        <address class="footer-address">
          <!-- <p>{siteConfig.address.street}</p> -->
          <!-- <p>{siteConfig.address.postalCode} {siteConfig.address.city}, {siteConfig.address.country}</p> -->
          <p class="footer-contact-line">
            <a href={`tel:${siteConfig.telephone.replace(/\s+/g, '')}`}>{siteConfig.telephone}</a>
            <span aria-hidden="true">·</span>
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </p>
        </address>
      </div>

      <nav class="footer-nav" aria-label="Enlaces principales">
        <h3>Navegación</h3>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Servicios principales">
        <h3>Servicios</h3>
        <ul>
          <li><a href="/servicios/tarjetas-visita">Tarjetas de visita</a></li>
        </ul>
      </nav>

      <div class="footer-hours">
        <h3>Horario</h3>
        <p class="footer-hours-main">{siteConfig.openingHours}</p>
        <p class="footer-note">Sábados y domingos: cerrado</p>
        <a href="/contacto" class="footer-cta">Solicitar presupuesto →</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {currentYear} {siteConfig.name}. Todos los derechos reservados.</p>
      <nav aria-label="Enlaces legales">
        <ul class="legal-links">
          <li><a href="/politica-privacidad">Política de privacidad</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #1b4334;
    color: #e8e6e0;
    padding: clamp(2rem, 4vw, 3rem) 0 1.5rem;
    border-top: 1px solid #1b4334;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: var(--space-xl) var(--space-2xl);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.7fr 0.9fr 0.9fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .footer-mark {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: -0.04em;
    border-radius: 8px;
    margin-bottom: var(--space-sm);
  }

  .footer-logo {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-sm);
    color: #fff;
    line-height: 1.2;
  }

  .footer-description {
    color: #a8aca7;
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0 0 var(--space-md);
    max-width: 36ch;
  }

  .footer-address {
    font-style: normal;
    color: #a8aca7;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .footer-address p {
    margin: 0;
    color: #a8aca7;
  }

  .footer-contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.6rem !important;
  }

  .footer-address a {
    color: #e8e6e0;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: 1px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .footer-address a:hover {
    color: #fff;
    border-bottom-color: rgba(255, 255, 255, 0.55);
  }

  .footer-nav h3,
  .footer-hours h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-md);
    color: #fff;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-nav li {
    margin-bottom: 0.55rem;
  }

  .footer-nav a {
    color: #a8aca7;
    font-size: 0.88rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-nav a:focus-visible,
  .legal-links a:focus-visible,
  .footer-address a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .footer-hours-main {
    color: #e8e6e0;
    font-weight: 600;
    font-size: 0.9rem;
    margin: 0 0 0.25rem;
  }

  .footer-note {
    font-size: 0.82rem;
    color: #8e918c;
    margin: 0 0 var(--space-md);
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .footer-cta:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-copy {
    margin: 0;
    color: #8e918c;
    font-size: 0.82rem;
  }

  .legal-links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .legal-links a {
    color: #8e918c;
    font-size: 0.82rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .legal-links a:hover {
    color: #e8e6e0;
  }
</style>
