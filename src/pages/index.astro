---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { siteConfig } from '@config/site';

const allServices = await getCollection('services');
const sortedServices = allServices.sort((a: any, b: any) => (a.data.order ?? 99) - (b.data.order ?? 99));
const services = sortedServices.map((entry: any) => ({
  title: entry.data.title.replace(' en Madrid', ''),
  description: entry.data.description,
  href: `/servicios/${entry.id}`,
  icon: entry.id === 'tarjetas-visita' ? '📇' : '📄',
}));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteConfig.url}/#business`,
  name: siteConfig.name,
  url: siteConfig.url,
  telephone: siteConfig.telephone,
  email: siteConfig.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address.street,
    postalCode: siteConfig.address.postalCode,
    addressLocality: siteConfig.address.city,
    addressCountry: siteConfig.address.country,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00',
  },
  priceRange: '€€',
  description: siteConfig.description,
};
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
  structuredData={structuredData}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Imprenta en Madrid — desde 2004</p>
        <h1 id="hero-title">
          Impresión que<br />
          <span class="hero-accent">deja huella.</span>
        </h1>
        <p class="hero-lead">
          Soluciones gráficas de autor para marcas exigentes.
          <span>{siteConfig.description}</span>
        </p>
        <p class="hero-sub">
          Atendemos a empresas, autónomos y particulares con rapidez, asesoramiento personalizado y materiales de primera calidad.
        </p>
        <div class="hero-actions">
          <a href="/contacto" class="btn btn-primary btn-lg hero-primary">
            Solicitar presupuesto
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/servicios" class="btn btn-secondary btn-lg">Explora nuestra calidad</a>
        </div>
        <ul class="hero-trust" aria-label="Garantías">
          <li>Entrega 24–48h</li>
          <li>Asesoramiento gratis</li>
          <li>Revisión de artes gratis</li>
          <li>Envío a toda España</li>
        </ul>
      </div>

      <div class="hero-media" role="img" aria-label="Ejemplos de trabajos impresos: tarjetas, catálogos y papelería sobre fondo verde salvia">
        <div class="hero-media-inner">
          <div class="media-stack" aria-hidden="true">
            <div class="media-card media-card--back"></div>
            <div class="media-card media-card--front">
              <span class="media-label">Brochure · Papelería</span>
              <span class="media-title">Entorno<br/>Publicitario</span>
              <span class="media-meta">Impresión offset · Papel 350g</span>
            </div>
            <div class="media-card media-card--small">
              <span>Tarjetas</span>
            </div>
            <div class="media-card media-card--tiny"></div>
          </div>
          <p class="media-caption">Fotografía real de trabajos — <span>plaza para imagen de producción</span></p>
        </div>
        <div class="hero-foliage hero-foliage--left" aria-hidden="true"></div>
        <div class="hero-foliage hero-foliage--right" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="section services-section" aria-labelledby="services-title">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Qué hacemos</p>
        <h2 id="services-title">Nuestros servicios</h2>
        <p class="section-description">Todo lo que necesitas para comunicar tu marca en papel y gran formato — con acabados que se notan al tacto.</p>
      </header>

      <div class="services-grid">
        {services.map((service: any) => <ServiceCard {...service} />)}
      </div>

      <div class="section-cta">
        <a href="/servicios" class="btn btn-secondary">Ver todos los servicios</a>
      </div>
    </div>
  </section>

  <section class="section why-section" aria-labelledby="why-title">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Por qué elegirnos</p>
        <h2 id="why-title">Artesanía, control y trato cercano</h2>
        <p class="section-description">Más de 20 años afinando cada detalle, del archivo a la entrega.</p>
      </header>

      <div class="why-grid">
        <article class="why-item">
          <div class="why-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <h3>Asesoramiento experto</h3>
          <p>Te guiamos en materiales, acabados y formatos para que el resultado supere lo que imaginaste.</p>
        </article>
        <article class="why-item">
          <div class="why-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Rapidez real</h3>
          <p>Producción propia en Madrid. Tiradas urgentes en 24h. Sin intermediarios ni esperas innecesarias.</p>
        </article>
        <article class="why-item">
          <div class="why-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="M21 21l-3.5-3.5"/></svg>
          </div>
          <h3>Revisión de artes gratis</h3>
          <p>Verificamos resolución, sangrados, color y fuentes antes de imprimir. Cero sorpresas.</p>
        </article>
        <article class="why-item">
          <div class="why-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05"/><path d="M12 22.08V12"/></svg>
          </div>
          <h3>Envío a toda España</h3>
          <p>Embalaje reforzado, tracking y seguro incluido en pedidos superiores a 100€.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-card">
        <div class="cta-copy">
          <p class="eyebrow cta-eyebrow">Da el siguiente paso</p>
          <h2 id="cta-title">¿Tienes un proyecto en mente?</h2>
          <p>Cuéntanos qué necesitas y te enviamos presupuesto sin compromiso en menos de 24h. Respuesta humana, no automática.</p>
        </div>
        <div class="cta-actions">
          <a href="/contacto" class="btn btn-primary btn-lg">Pedir presupuesto</a>
          <a href={`tel:${siteConfig.telephone.replace(/\s+/g, '')}`} class="btn btn-secondary btn-lg cta-tel">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {siteConfig.telephone}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero — editorial split, warm */
  .hero {
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(2rem, 5vw, 3rem);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    overflow: clip;
  }

  .hero-inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.05fr 1.15fr;
      gap: clamp(2rem, 4vw, 3.5rem);
      min-height: 520px;
    }
  }

  .hero-copy {
    max-width: 560px;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-md);
  }

  #hero-title {
    margin-bottom: var(--space-md);
    line-height: 0.92;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .hero-accent {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    text-transform: none;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    display: inline-block;
  }

  .hero-lead {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.45;
    color: var(--color-text);
    margin: 0 0 var(--space-sm);
    text-wrap: balance;
  }

  .hero-lead span {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    display: block;
    margin-top: 0.45rem;
    line-height: 1.6;
  }

  .hero-sub {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .hero-primary {
    box-shadow: 0 4px 14px rgba(61, 74, 54, 0.18);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hero-trust li {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.38rem 0.65rem;
    border-radius: var(--radius-pill);
    line-height: 1;
  }

  /* Hero media — large photography area, sage */
  .hero-media {
    position: relative;
    background: #dde3da;
    border: 1px solid #d2d8cf;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 3.15;
    min-height: 380px;
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
  }

  .hero-media-inner {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .media-stack {
    position: relative;
    width: 100%;
    aspect-ratio: 1.15;
    display: grid;
    place-items: center;
  }

  .media-card {
    position: absolute;
    background: var(--color-surface);
    border: 1px solid rgba(29, 33, 30, 0.08);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgba(29, 33, 30, 0.12), 0 2px 8px rgba(29, 33, 30, 0.08);
  }

  .media-card--back {
    width: 62%;
    aspect-ratio: 0.92;
    right: 2%;
    top: 6%;
    background: #f5f1e8;
    transform: rotate(3deg);
  }

  .media-card--front {
    width: 68%;
    aspect-ratio: 0.9;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-1.5deg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.1rem 1rem 0.9rem;
    background: #fdfbf7;
    z-index: 2;
  }

  .media-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  .media-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .media-meta {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 0.55rem;
    margin-top: 0.5rem;
  }

  .media-card--small {
    width: 42%;
    aspect-ratio: 1.55;
    left: 0;
    bottom: 4%;
    transform: rotate(-4deg);
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: #fff;
    z-index: 3;
  }

  .media-card--tiny {
    width: 28%;
    aspect-ratio: 1.4;
    right: 6%;
    bottom: 1%;
    background: #eef1eb;
    transform: rotate(5deg);
    z-index: 1;
    opacity: 0.9;
  }

  .media-caption {
    font-size: 0.72rem;
    color: #5a6258;
    text-align: center;
    line-height: 1.4;
    margin: 0;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(6px);
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(29, 33, 30, 0.06);
  }

  .media-caption span {
    color: var(--color-text-muted);
  }

  .hero-foliage {
    position: absolute;
    width: 120px;
    height: 120px;
    background: radial-gradient(ellipse at 30% 30%, #a8b8a0 0%, transparent 62%);
    opacity: 0.22;
    pointer-events: none;
  }

  .hero-foliage--left {
    left: -18px;
    bottom: -10px;
    transform: rotate(-18deg);
  }

  .hero-foliage--right {
    right: -16px;
    top: -12px;
    width: 140px;
    height: 140px;
    opacity: 0.16;
  }

  @media (max-width: 959px) {
    .hero-media {
      aspect-ratio: 16 / 11;
      min-height: 340px;
      order: -1;
    }

    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 1.25rem;
    }

    .hero-media {
      min-height: 300px;
      aspect-ratio: 1.15;
      margin-inline: -0.25rem;
      border-radius: var(--radius-lg);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      justify-content: center;
      width: 100%;
    }

    #hero-title {
      font-size: clamp(2rem, 9vw, 2.6rem);
    }
  }

  /* Services — editorial grid */
  .services-section {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .section-cta {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  /* Why — clean editorial, not cards */
  .why-section {
    background: var(--color-background);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .why-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .why-item:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }

  .why-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--color-primary-light);
    border-radius: 10px;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .why-item h3 {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .why-item p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  /* CTA — warm editorial, not solid primary */
  .cta-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-3xl) 0;
  }

  .cta-card {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .cta-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 600px 300px at 85% -10%, rgba(255, 255, 255, 0.08), transparent 60%);
    pointer-events: none;
  }

  @media (min-width: 860px) {
    .cta-card {
      grid-template-columns: 1.2fr auto;
      padding: 2.4rem 2.5rem;
    }
  }

  .cta-copy {
    position: relative;
  }

  .cta-eyebrow {
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: var(--space-sm);
  }

  .cta-eyebrow::before {
    background: rgba(255, 255, 255, 0.35);
  }

  .cta-card h2 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--space-sm);
    line-height: 1.05;
  }

  .cta-card p {
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 48ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    position: relative;
    align-items: center;
  }

  .cta-actions .btn-primary {
    background: #fff;
    border-color: #fff;
    color: var(--color-primary);
  }

  .cta-actions .btn-primary:hover {
    background: var(--color-primary-light);
    border-color: #fff;
    color: var(--color-primary-hover);
  }

  .cta-tel {
    background: transparent !important;
    border-color: rgba(255, 255, 255, 0.55) !important;
    color: #fff !important;
  }

  .cta-tel:hover {
    background: rgba(255, 255, 255, 0.12) !important;
    border-color: #fff !important;
    color: #fff !important;
  }

  @media (max-width: 559px) {
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
