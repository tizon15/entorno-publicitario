---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import ServiceCard from '@components/ServiceCard.astro'
import { siteConfig } from '@config/site'

const allServices = await getCollection('services')
const sortedServices = allServices.sort((a: any, b: any) => (a.data.order ?? 99) - (b.data.order ?? 99))
const services = sortedServices.map((entry: any) => ({
  title: entry.data.title.replace(' en Madrid', ''),
  description: entry.data.description,
  href: `/servicios/${entry.id}`,
  icon: entry.id === 'tarjetas-visita' ? '📇' : '📄'
}))

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteConfig.url}/#business`,
  name: siteConfig.name,
  url: siteConfig.url,
  telephone: siteConfig.telephone,
  email: siteConfig.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address.street,
    postalCode: siteConfig.address.postalCode,
    addressLocality: siteConfig.address.city,
    addressCountry: siteConfig.address.country
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00'
  },
  priceRange: '€€',
  description: siteConfig.description
}
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} structuredData={structuredData}>
  <section class='hero' aria-labelledby='hero-title'>
    <div class='container hero-inner'>
      <div class='hero-copy'>
        <p class='eyebrow hero-eyebrow'>Imprenta en Madrid — desde 2004</p>
        <h1 id='hero-title'>
          Impresión que
          <span class='hero-accent'>deja huella.</span>
        </h1>
        <p class='hero-lead'>
          Soluciones gráficas de autor para marcas exigentes.
          <span>{siteConfig.description}</span>
        </p>
        <p class='hero-sub'>
          Atendemos a empresas, autónomos y particulares con rapidez, asesoramiento personalizado y materiales de
          primera calidad.
        </p>
        <div class='hero-actions'>
          <a href='/contacto' class='btn btn-primary btn-lg hero-primary'>
            Solicitar presupuesto
            <svg
              width='16'
              height='16'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              aria-hidden='true'><path d='M5 12h14M12 5l7 7-7 7'></path></svg
            >
          </a>
          <a href='/servicios' class='btn btn-secondary btn-lg'>Explora nuestra calidad</a>
        </div>
        <ul class='hero-trust' aria-label='Garantías'>
          <li>Entrega 24–48h</li>
          <li>Asesoramiento gratis</li>
          <li>Revisión de artes gratis</li>
          <li>Envío a toda España</li>
        </ul>
        <p class='hero-note' aria-hidden='true'>— muestras y pruebas en taller · papel 350g · tintas vegetal</p>
      </div>

      <div class='hero-media' role='img' aria-label='Mesa de trabajo con papeles, tarjetas y pruebas de color'>
        <div class='hero-media-inner'>
          <div class='color-bar' aria-hidden='true'><span></span><span></span><span></span><span></span></div>
          <div class='media-stack' aria-hidden='true'>
            <div class='media-card media-card--back'></div>
            <div class='media-card media-card--front'>
              <span class='media-label'>01 · Papelería</span>
              <span class='media-title'>Entorno<br />Publicitario</span>
              <span class='media-meta'>Offset · 350g · FSC · Madrid</span>
            </div>
            <div class='media-card media-card--small'>
              <span>Tarjetas 85×55</span>
            </div>
            <div class='media-card media-card--tiny'></div>
            <div class='tape' aria-hidden='true'></div>
          </div>
          <p class='media-caption'>Plaza para fotografía real — mesa de taller con pruebas impresas</p>
        </div>
        <div class='marginalia' aria-hidden='true'>TALLER PROPIO — MADRID · PRUEBA FÍSICA</div>
      </div>
    </div>
  </section>

  <section class='section services-section' aria-labelledby='services-title'>
    <div class='container'>
      <header class='section-header'>
        <p class='eyebrow'>Qué hacemos</p>
        <h2 id='services-title'>Nuestros servicios</h2>
        <p class='section-description'>
          Todo lo que necesitas para comunicar tu marca en papel y gran formato — con acabados que se notan al tacto.
        </p>
      </header>

      <div class='services-grid'>
        {services.map((service: any) => <ServiceCard {...service} />)}
      </div>

      <div class='section-cta'>
        <a href='/servicios' class='btn btn-secondary'>Ver todos los servicios</a>
      </div>
    </div>
  </section>

